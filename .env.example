# Copy to .env and fill in. .env is git-ignored.

# Which Claude backend to use.
#   claude-cli  (default) runs the local Claude Code CLI on your Claude subscription login.
#               Install Claude Code, run `claude` once to log in, and no API key is needed.
#               It uses your plan's usage limits and is slower than the API.
#   api         calls the Anthropic API. Needs ANTHROPIC_API_KEY and is billed per token.
LLM_BACKEND=claude-cli
# CLAUDE_CLI_PATH=claude          # full path if `claude` is not on PATH
# CLI_CONCURRENCY=3               # CLI calls running at once
# CLI_TIMEOUT_S=180               # per call

# Only for LLM_BACKEND=api.
ANTHROPIC_API_KEY=sk-ant-...

# Models per pipeline stage. All default to Haiku 5.5, which keeps a hunt cheap.
# Quality upgrade: set RANK_MODEL and PLANNER_MODEL to claude-opus-5-5. Ranking and planning
# decide which listings you see, so they benefit most. Opus costs roughly 40x more per token.
# With the claude-cli backend, these map to the CLI's haiku, sonnet and opus aliases.
PLANNER_MODEL=claude-haiku-5-5
TRIAGE_MODEL=claude-haiku-5-5
EXTRACT_MODEL=claude-haiku-5-5
SPECS_MODEL=claude-haiku-5-5
RANK_MODEL=claude-haiku-5-5
# PLANNER_MODEL=claude-opus-5-5
# RANK_MODEL=claude-opus-5-5

# Vinted access.
VINTED_BASE_URL=https://www.vinted.fr
VINTED_MIN_DELAY_S=2.5

# Search and cost limits.
SEARCH_PAGES=1
MAX_CANDIDATES=300
MAX_DETAILED=60
MAX_PHOTOS=6

# Web specs research. By default every distinct model of a hunt is researched once. SPECS_MAX_PER_HUNT is an
# optional cap for cost control: when it is a positive number, the most relevant listings are researched first and
# the models past the cap are marked "not researched (limit)". 0 means unlimited (the default). Models already in
# the cache are reused and do not count against the cap. Listings that already fail a hard requirement are never
# researched.
SPECS_MAX_PER_HUNT=0
# Lifetime in hours of cached web specs that are not for the exact variant, and of "no specs found" answers.
# Exact-variant specs with values never expire.
SPECS_NONEXACT_TTL_HOURS=72

# Shipping in the budget. The search stage filters on the total price (incl. buyer fees) only. After the item
# pages are read, a listing whose total plus Vinted's default shipping price is over budget is rejected, and a
# listing whose shipping is unknown is kept. Set to false to budget on the total price alone.
INCLUDE_SHIPPING_IN_BUDGET=true

# Cache and saved hunts (relative paths are resolved from the project root).
DATA_DIR=./data
